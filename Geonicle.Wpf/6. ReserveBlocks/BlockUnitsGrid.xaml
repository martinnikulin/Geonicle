<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.BlockUnitsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:models="clr-namespace:Data.Models;assembly=Geonicle.Data"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus"
    xmlns:behaviors="clr-namespace:Geonicle.Wpf.Behaviors">

    <UserControl.Resources>
        <!-- EditSettings колонок не видят DataContext, поэтому справочники берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (ReserveBlocksViewModel). Колонки и настройки грида «Скважины в блоке» описаны только здесь.
         «Скважина» — список «скважина, комментарий» из пластопересечений пласта и прослоя (запись в HoleName) или свой текст
         для строки без скважины. «От» и «До» — из пластопересечения, только чтение. -->
    <dxg:GridControl
        ItemsSource="{Binding SelectedBlock.BlockUnits}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        behaviors:GridRefresh.RefreshOnSave="True"
        RestoreStateKeyFieldName="Id"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="HoleSeamId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="HoleName" Header="Скв">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.HoleTexts, Source={StaticResource ViewModelProxy}}"
                        IsTextEditable="True" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="DepthFrom" Header="От" ReadOnly="True" />
            <dxg:GridColumn FieldName="DepthTo" Header="До" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdCoal" Header="Ad угля" />
            <dxg:GridColumn FieldName="AdFull" Header="Ad засор." />
            <dxg:GridColumn FieldName="AdR" Header="" />
            <dxg:GridColumn FieldName="ThCoal" Header="М угля" />
            <dxg:GridColumn FieldName="ThFull" Header="М засор." />
            <dxg:GridColumn FieldName="ThR" Header="" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding UnitsMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused"
                CellValueChanged="View_CellValueChanged" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
