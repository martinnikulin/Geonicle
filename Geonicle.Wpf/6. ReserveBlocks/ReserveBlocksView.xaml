<UserControl
    x:Class="Geonicle.Wpf.Views.ReserveBlocksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:grids="clr-namespace:Geonicle.Wpf.Views.Grids"
    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="530">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding InitializeCommand}"
                               EventName="Loaded"/>
    </dxmvvm:Interaction.Behaviors>

    <!-- Экран только размещает: сверху грид «Блоки» и поле комментария выбранного блока, снизу вкладки «Части блока»
         и «Скважины в блоке». Колонки и настройки каждого грида — в его файле в папке экрана. -->
    <dxlc:LayoutControl Orientation="Vertical" Padding="0">
        <dxlc:LayoutGroup View="Tabs"
                          dxlc:LayoutControl.AllowVerticalSizing="True">
            <dxlc:LayoutGroup Header="Блоки">
                <grids:BlocksGrid />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>

        <dxlc:LayoutItem Label="Комментарии" LabelPosition="Top"
                         dxlc:LayoutControl.AllowVerticalSizing="True">
            <dxe:TextEdit EditValue="{Binding SelectedBlock.Comments, UpdateSourceTrigger=PropertyChanged}"
                          AcceptsReturn="True"
                          TextWrapping="Wrap"
                          VerticalContentAlignment="Top"
                          Height="70" />
        </dxlc:LayoutItem>

        <dxlc:LayoutGroup View="Tabs">
            <dxlc:LayoutGroup Header="Части блока">
                <grids:BlockDetailsGrid />
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Header="Скважины в блоке">
                <grids:BlockUnitsGrid />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
