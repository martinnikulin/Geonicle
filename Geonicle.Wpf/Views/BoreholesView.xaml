<UserControl
    x:Class="Geonicle.Wpf.Views.BoreholesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" 
    xmlns:ViewModels="clr-namespace:Geonicle.Wpf.ViewModels"
    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="530">
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding InitializeCommand}"
                               EventName="Loaded"/>
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Orientation="Vertical" Padding="0">
        <dxlc:LayoutGroup Header="Скважины" 
                          View="Group" 
                          dxlc:LayoutControl.AllowVerticalSizing="True">
            <dxg:GridControl  
                         ItemsSource="{Binding Boreholes}"
                         SelectedItem="{Binding SelectedBorehole, Mode=TwoWay}"
                         ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
                         AutoGenerateColumns="AddNew"
                         RestoreStateKeyFieldName="BoreholeId" 
                         RestoreStateOnSourceChange="True"
                         EnableSmartColumnsGeneration="True">
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem Alignment="Left" SummaryType="Count"/>
            </dxg:GridControl.TotalSummary>

                <dxg:GridControl.View>
                    <dxg:TableView 
                            DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow" 
                            ShowGroupPanel="False" 
                            ShowDataNavigator="True"
                            AutoWidth="True"
                            EditorShowMode="MouseDownFocused">
                        <!--ShowUpdateRowButtons="OnCellEditorOpen">-->

                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
        
        <dxlc:LayoutGroup Header="Инклинометрия" 
                          View="Group" >
            <dxg:GridControl x:Name="surveyGrid" 
                         ItemsSource="{Binding SelectedBorehole.Surveys}"
                         AutoGenerateColumns="AddNew">

                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem Alignment="Left" SummaryType="Count"/>
                </dxg:GridControl.TotalSummary>
                <dxg:GridControl.View>
                    <dxg:TableView 
                        DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow" 
                        ShowGroupPanel="False" 
                        ShowDataNavigator="True"
                        AutoWidth="True"
                        EditorShowMode="MouseDownFocused">
                        <!--ShowUpdateRowButtons="OnCellEditorOpen">-->
                        <dxmvvm:Interaction.Behaviors>
                            <!--<dxmvvm:EventToCommand
                                EventName="RowUpdated"
                                Command="{Binding SaveCommand}" />-->
                        </dxmvvm:Interaction.Behaviors>
                    </dxg:TableView>
                </dxg:GridControl.View>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
