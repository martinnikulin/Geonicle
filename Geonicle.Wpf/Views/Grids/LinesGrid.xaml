<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.LinesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:models="clr-namespace:Data.Models;assembly=Geonicle.Data"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus">

    <!-- DataContext наследуется от экрана (LinesViewModel). Колонки и настройки грида «Разведочные линии» описаны только здесь. -->
    <dxg:GridControl
        ItemsSource="{Binding Lines}"
        SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        RestoreStateKeyFieldName="LineId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="LineId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="LineType" Header="Тип">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{dxe:EnumItemsSource EnumType={x:Type models:LineType}}"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="N" Header="N" />
            <dxg:GridColumn FieldName="Description" Header="Название" />
            <dxg:GridColumn FieldName="X1" Header="X начала" />
            <dxg:GridColumn FieldName="Y1" Header="Y начала" />
            <dxg:GridColumn FieldName="X2" Header="X конца" />
            <dxg:GridColumn FieldName="Y2" Header="Y конца" />
            <dxg:GridColumn FieldName="Lock" Header="Блокировка" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding LinesMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
