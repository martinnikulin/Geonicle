<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.BoreholesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus">

    <!-- DataContext наследуется от экрана (BoreholesViewModel). Колонки и настройки грида «Скважины» описаны только здесь. -->
    <dxg:GridControl
        ItemsSource="{Binding Boreholes}"
        SelectedItem="{Binding SelectedBorehole, Mode=TwoWay}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        RestoreStateKeyFieldName="BoreholeId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="BoreholeId" Header="Id" ReadOnly="True" />
            <dxg:GridColumn FieldName="HoleType" Header="Тип" />
            <dxg:GridColumn FieldName="HoleName" Header="Название" />
            <dxg:GridColumn FieldName="X" Header="X" />
            <dxg:GridColumn FieldName="Y" Header="Y" />
            <dxg:GridColumn FieldName="Z" Header="Z" />
            <dxg:GridColumn FieldName="Depth" Header="Глубина" />
            <dxg:GridColumn FieldName="Comments" Header="Комментарии" />
            <dxg:GridColumn FieldName="OnMap" Header="На карте" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding BoreholesMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
