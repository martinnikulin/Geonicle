<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.LineHolesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus">

    <UserControl.Resources>
        <!-- EditSettings колонки не видят DataContext, поэтому список скважин берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (LinesViewModel). Колонки и настройки грида «Скважины в разведочных линиях» описаны только здесь. -->
    <dxg:GridControl
        ItemsSource="{Binding SelectedLine.LineHoles}"
        AutoGenerateColumns="None"
        RestoreStateKeyFieldName="LineHoleId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn Name="colBoreholeId" FieldName="BoreholeId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="N" Header="N" />
            <dxg:GridColumn Name="colBorehole" FieldName="BoreholeId" Header="Скважина">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.BoreholeLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="BoreholeId"
                        DisplayMember="HoleName"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Node" Header="Узел" />
            <dxg:GridColumn FieldName="SpreadAzimuth" Header="Азимут проекции" />
            <dxg:GridColumn FieldName="OnProfile" Header="На карте" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding LineHolesMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
