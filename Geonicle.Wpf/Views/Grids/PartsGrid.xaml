<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.PartsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus">

    <!-- DataContext наследуется от экрана (SeamsViewModel). Колонки и настройки грида «Детали» описаны только здесь. -->
    <dxg:GridControl
        ItemsSource="{Binding SelectedSeam.Parts}"
        AutoGenerateColumns="None"
        RestoreStateKeyFieldName="PartId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="PartId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="Chapter" Header="Приложение" />
            <dxg:GridColumn FieldName="N" Header="N" />
            <dxg:GridColumn FieldName="Npart" Header="Деталь №" />
            <dxg:GridColumn FieldName="Vertical" Header="Вертикальная" />
            <dxg:GridColumn FieldName="Description" Header="Описание" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding PartsMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
