<dx:ThemedWindow
    x:Class="Geonicle.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:vm="clr-namespace:Geonicle.Wpf.ViewModels"
    xmlns:views="clr-namespace:Geonicle.Wpf.Views"
    Title="MainWindow" Height="600" Width="1000">
    
    <dx:ThemedWindow.Resources>
        <!-- EditSettings списков на ленте не видят DataContext, поэтому списки берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <DataTemplate DataType="{x:Type vm:BoreholesViewModel}">
            <views:BoreholesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinesViewModel}">
            <views:LinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeamsViewModel}">
            <views:SeamsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LithologyViewModel}">
            <views:LithologyView />
        </DataTemplate>
    </dx:ThemedWindow.Resources>


    <DockPanel>
        
        <dxr:RibbonControl 
            DockPanel.Dock="Top" 
            RibbonStyle="Office2019" IsHiddenRibbonCollapsed="False" IsSimplified="False">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage Caption="Данные">
                    <dxr:RibbonPageGroup IsVisible="{Binding IsDataGroupVisible}">

                        <dxb:BarButtonItem x:Name="saveItem" 
                                           Content="Сохранить" 
                                           Glyph="{dx:DXImage Office2013/Save/Save_16x16.png}"                                           
                                           LargeGlyph="{dx:DXImage Office2013/Save/Save_32x32.png}"
                                           Command="{Binding SaveCommand}" />
                        <!--ItemClick="SaveItem_ItemClick"/>-->
                        <dxb:BarButtonItem x:Name="refreshItem"
                                           Content="Обновить"
                                           Glyph="{dx:DXImage Office2013/Actions/Refresh_16x16.png}"
                                           LargeGlyph="{dx:DXImage Office2013/Actions/Refresh_32x32.png}"
                                           Command="{Binding RefreshCommand}" />
                        <dxb:BarButtonItem x:Name="newRowItem"
                                           Content="Добавить строку"
                                           Glyph="{dx:DXImage Office2013/Actions/Insert_16x16.png}"
                                           LargeGlyph="{dx:DXImage Office2013/Actions/Insert_32x32.png}"
                                           Command="{x:Static dxg:GridCommands.AddNewRow}" />
                        <!--Command="{Binding AddNewRowCommand}" />-->
                        <dxb:BarButtonItem x:Name="deleteRowItem"
                                           Content="Удалить строку"
                                           Glyph="{dx:DXImage Office2013/Reports/DeleteHeader_16x16.png}"
                                           LargeGlyph="{dx:DXImage Office2013/Reports/DeleteHeader_32x32.png}"
                                           Command="{x:Static dxg:GridCommands.DeleteFocusedRow}"
                                           />
                    </dxr:RibbonPageGroup>

                    <!-- Видна на экранах, где данные фильтруются по разделяющему прослою. -->
                    <dxr:RibbonPageGroup Caption="Прослой" IsVisible="{Binding IsInterbedGroupVisible}">
                        <dxb:BarStaticItem x:Name="interbedCaptionItem" Content="Разделяющий прослой" />
                        <dxb:BarEditItem x:Name="interbedItem"
                                         EditWidth="120"
                                         EditValue="{Binding Filters.SelectedInterbedId, Mode=TwoWay}">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:ComboBoxEditSettings
                                    ItemsSource="{Binding Data.Filters.Interbeds, Source={StaticResource ViewModelProxy}}"
                                    ValueMember="InterbedId"
                                    DisplayMember="InterbedName"
                                    IsTextEditable="False" />
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                    </dxr:RibbonPageGroup>

                    <!-- Видна только на экране «Данные по скважинам». -->
                    <dxr:RibbonPageGroup Caption="Скважина" IsVisible="{Binding IsLineBoreholeGroupVisible}">
                        <dxb:BarEditItem x:Name="lineItem"
                                         Content="Разведочная линия"
                                         EditWidth="120"
                                         EditValue="{Binding Filters.SelectedLineId, Mode=TwoWay}">
                            <dxb:BarEditItem.EditSettings>
                                <dxg:LookUpEditSettings
                                    ItemsSource="{Binding Data.Filters.Lines, Source={StaticResource ViewModelProxy}}"
                                    ValueMember="LineId"
                                    DisplayMember="Description"
                                    AutoPopulateColumns="False"
                                    IsTextEditable="False">
                                    <dxg:LookUpEditSettings.PopupContentTemplate>
                                        <ControlTemplate>
                                            <!-- Список приходит уже отсортированным по N; колонки: ID и название. -->
                                            <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False" AutoGenerateColumns="None">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="LineId" Header="ID" Width="70" />
                                                    <dxg:GridColumn FieldName="Description" Header="Название" Width="200" />
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="True" ShowColumnHeaders="True" ShowGroupPanel="False" ShowIndicator="False" AllowEditing="False" />
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEditSettings.PopupContentTemplate>
                                </dxg:LookUpEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>

                        <dxb:BarEditItem x:Name="boreholeItem"
                                         Content="Скважины"
                                         EditWidth="120"
                                         EditValue="{Binding Filters.SelectedBoreholeId, Mode=TwoWay}">
                            <dxb:BarEditItem.EditSettings>
                                <dxg:LookUpEditSettings
                                    ItemsSource="{Binding Data.Filters.Boreholes, Source={StaticResource ViewModelProxy}}"
                                    ValueMember="BoreholeId"
                                    DisplayMember="HoleName"
                                    AutoPopulateColumns="False"
                                    IsTextEditable="False">
                                    <dxg:LookUpEditSettings.PopupContentTemplate>
                                        <ControlTemplate>
                                            <!-- Список приходит уже отсортированным по N; колонки: ID и название. -->
                                            <dxg:GridControl x:Name="PART_GridControl" ShowBorder="False" AutoGenerateColumns="None">
                                                <dxg:GridControl.Columns>
                                                    <dxg:GridColumn FieldName="BoreholeId" Header="ID" Width="70" />
                                                    <dxg:GridColumn FieldName="HoleName" Header="Название" Width="200" />
                                                </dxg:GridControl.Columns>
                                                <dxg:GridControl.View>
                                                    <dxg:TableView AutoWidth="True" ShowColumnHeaders="True" ShowGroupPanel="False" ShowIndicator="False" AllowEditing="False" />
                                                </dxg:GridControl.View>
                                            </dxg:GridControl>
                                        </ControlTemplate>
                                    </dxg:LookUpEditSettings.PopupContentTemplate>
                                </dxg:LookUpEditSettings>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>

                        <dxb:BarCheckItem x:Name="allBoreholesItem"
                                          Content="Все скважины"
                                          IsChecked="{Binding Filters.AllBoreholes, Mode=TwoWay}" />
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>

        <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
            <dxr:RibbonStatusBarControl.RightItems>
                <dxb:BarButtonItem 
                    x:Name="printItem" 
                    Content="Print" 
                    Glyph="{dx:DXImage SvgImages/Print/Print.svg}"/>
            </dxr:RibbonStatusBarControl.RightItems>
        </dxr:RibbonStatusBarControl>
        
        <dxa:AccordionControl 
            DockPanel.Dock="Left" 
            SelectedItemChanged="AccordionControl_SelectedItemChanged">
            
            <dxa:AccordionItem Header="Первичные данные" IsExpanded="True">
                <dxa:AccordionItem Header="Скважины" Tag="{x:Type vm:BoreholesViewModel}" />
                <dxa:AccordionItem Header="Разведочные линии" Tag="{x:Type vm:LinesViewModel}" />
                <dxa:AccordionItem Header="Пласты" Tag="{x:Type vm:SeamsViewModel}" />
                <dxa:AccordionItem Header="Данные по скважинам" Tag="{x:Type vm:LithologyViewModel}" />
            </dxa:AccordionItem>
            <dxa:AccordionItem Header="Подсчет запасов">
                <dxa:AccordionItem Header="Пластопересечения" />
                <dxa:AccordionItem Header="Блоки запасов" />
            </dxa:AccordionItem>
            <dxa:AccordionItem Header="Запросы" />
            <dxa:AccordionItem Header="Справочники">
                <dxa:AccordionItem Header="Породы" />
                <dxa:AccordionItem Header="Показатели качества" />
            </dxa:AccordionItem>
            
        </dxa:AccordionControl>

        <ContentControl x:Name="mainContent"  Content="{Binding CurrentViewModel}" />
    </DockPanel>
</dx:ThemedWindow>
