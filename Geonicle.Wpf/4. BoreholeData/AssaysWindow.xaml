<dx:ThemedWindow
    x:Class="Geonicle.Wpf.Views.AssaysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="{Binding Title}"
    Width="520" Height="640"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <!-- Окно «Анализы» пробы (немодальное). Значения правятся только в колонке «Значение»;
         «ОК» записывает анализы в БД и закрывает окно, «Отмена» закрывает без сохранения. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxe:CheckEdit Grid.Row="0"
                       Content="По группам"
                       Margin="0,0,0,8"
                       IsChecked="{Binding GroupByGroups, Mode=TwoWay}" />

        <!-- Группа сортируется по порядку группы (GroupN), показатели внутри группы — по номеру (N). -->
        <dxg:GridControl Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         AutoGenerateColumns="None"
                         AutoExpandAllGroups="True">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="GroupName" Header="Группа" ReadOnly="True"
                                GroupIndex="{Binding GroupIndex}"
                                SortFieldName="GroupN" SortIndex="0" SortOrder="Ascending" />
                <dxg:GridColumn FieldName="N" Header="№" ReadOnly="True" Width="50"
                                SortIndex="1" SortOrder="Ascending" />
                <dxg:GridColumn FieldName="Description" Header="Параметр" ReadOnly="True" Width="220" />
                <dxg:GridColumn FieldName="Val" Header="Значение" Width="120" />
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="False"
                               ShowDataNavigator="False"
                               AllowSorting="False"
                               EditorShowMode="MouseDownFocused" />
            </dxg:GridControl.View>
        </dxg:GridControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="ОК" Width="90" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
