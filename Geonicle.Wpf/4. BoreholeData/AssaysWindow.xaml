<dx:ThemedWindow
    x:Class="Geonicle.Wpf.Views.AssaysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="{Binding Title}"
    Width="520" Height="640"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <!-- Окно «Анализы» пробы (немодальное). Значения правятся только в колонке «Значение»;
         «ОК» записывает анализы в БД и закрывает окно, «Отмена» закрывает без сохранения. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Сразу сгруппировано по группе (GroupIndex="0"); группа сортируется по порядку группы (GroupN),
             показатели внутри группы — по номеру (N). Другие колонки можно группировать на панели группировки. -->
        <dxg:GridControl Grid.Row="0"
                         ItemsSource="{Binding Rows}"
                         AutoGenerateColumns="None"
                         AutoExpandAllGroups="True">
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="GroupName" Header="Группа" ReadOnly="True"
                                GroupIndex="0"
                                SortFieldName="GroupN" SortIndex="0" SortOrder="Ascending" />
                <dxg:GridColumn FieldName="N" Header="№" ReadOnly="True"
                                SortIndex="1" SortOrder="Ascending" />
                <dxg:GridColumn FieldName="Description" Header="Параметр" ReadOnly="True" />
                <dxg:GridColumn FieldName="Val" Header="Значение" />
            </dxg:GridControl.Columns>

            <dxg:GridControl.View>
                <dxg:TableView ShowGroupPanel="True"
                               ShowDataNavigator="False"
                               AutoWidth="True"
                               AllowSorting="False"
                               EditorShowMode="MouseDownFocused" />
            </dxg:GridControl.View>
        </dxg:GridControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="ОК" Width="90" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
