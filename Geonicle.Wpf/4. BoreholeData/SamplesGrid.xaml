<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.SamplesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus"
    xmlns:behaviors="clr-namespace:Geonicle.Wpf.Behaviors">

    <UserControl.Resources>
        <!-- EditSettings и колонки не видят DataContext, поэтому справочник и режим берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <!-- Добавление и удаление проб доступны только в режиме всей скважины; в режиме пластопересечения в навигаторе остаётся перемещение. -->
        <dxmvvm:BooleanToObjectConverter x:Key="NavigatorButtons"
                                         TrueValue="Navigation, AddNewRow, DeleteFocusedRow"
                                         FalseValue="Navigation" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (BoreholeDataViewModel). Колонки и настройки грида «Пробы» описаны только здесь.
         Строки — SampleRow: правятся проба (SampleDef) и «Принято» (HSSamps.Accepted); колонки Ad только для чтения
         (их считает представление Samples). FilterCriteria задаёт модель (в режиме пластопересечения — пробы пласта). -->
    <dxg:GridControl
        ItemsSource="{Binding Samples}"
        FilterCriteria="{Binding SamplesFilterCriteria, Mode=OneWay}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        behaviors:GridRefresh.RefreshOnSave="True"
        RestoreStateKeyFieldName="SampleId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="N" Header="N" ReadOnly="True" />
            <dxg:GridColumn FieldName="SampleId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="Accepted" Header="Принято"
                            ReadOnly="{Binding Data.AcceptedReadOnly, Source={StaticResource ViewModelProxy}}" />
            <dxg:GridColumn FieldName="Bad" Header="Брак" />
            <dxg:GridColumn FieldName="Nsample" Header="Номер пробы" />
            <dxg:GridColumn FieldName="DepthFrom" Header="От" />
            <dxg:GridColumn FieldName="DepthTo" Header="До" />
            <dxg:GridColumn FieldName="Ad" Header="Ad" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdFloat" Header="Ad флот" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdGbs" Header="Ad гбс" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdGeophys" Header="Ad геофиз" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdSeam" Header="Ad пласт" ReadOnly="True" />
            <dxg:GridColumn FieldName="AdIndex" Header="Притято по">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.AdIndexLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding SamplesMenu}"
                DataNavigatorButtons="{Binding CanAddOrDeleteSamples, Converter={StaticResource NavigatorButtons}}"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused"
                ShowFilterPanelMode="Never" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
