<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DevExpress.Mvvm" Version="26.1.6" />
        <PackageReference Include="DevExpress.Wpf" Version="26.1.6" />
        <PackageReference Include="DevExpress.Wpf.ThemesLW" Version="26.1.6" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Geonicle.Data\Geonicle.Data.csproj" />
    </ItemGroup>

</Project>