<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.AveragesGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:models="clr-namespace:Data.Models;assembly=Geonicle.Data"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus"
    xmlns:behaviors="clr-namespace:Geonicle.Wpf.Behaviors">

    <UserControl.Resources>
        <!-- EditSettings колонок не видят DataContext, поэтому справочники берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (SeamIntersectionsViewModel). Колонки и настройки грида «Средние» описаны только здесь.
         Строки добавляются и удаляются только в этом гриде (пласт и прослой подставляются с ленты). Ключ составной,
         поэтому RestoreStateKeyFieldName не задаём. «Значение» считает процедура БД (только чтение), «Польз.» вводит пользователь. -->
    <dxg:GridControl
        ItemsSource="{Binding Averages}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        behaviors:GridRefresh.RefreshOnSave="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="CoalType" Header="Тип">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.CoalTypeLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="CoalGrade" Header="Марка">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.CoalGradeLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="VarId" Header="Показатель">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.AssayVarLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Value" Header="Значение" ReadOnly="True" />
            <dxg:GridColumn FieldName="UserValue" Header="Польз." />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding AveragesMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused"
                ShowingEditor="View_ShowingEditor" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
