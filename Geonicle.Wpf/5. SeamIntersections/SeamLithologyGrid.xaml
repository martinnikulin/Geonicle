<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.SeamLithologyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:models="clr-namespace:Data.Models;assembly=Geonicle.Data"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus"
    xmlns:behaviors="clr-namespace:Geonicle.Wpf.Behaviors">

    <UserControl.Resources>
        <!-- EditSettings колонок не видят DataContext, поэтому справочники берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (SeamIntersectionsViewModel). Колонки и настройки грида «Литология» описаны только здесь.
         Показываются слои выбранного пластопересечения; строки не добавляются и не удаляются. -->
    <dxg:GridControl
        ItemsSource="{Binding Lithology}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        behaviors:GridRefresh.RefreshOnSave="True"
        RestoreStateKeyFieldName="LithologyId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="LithologyId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="DepthFrom" Header="От" />
            <dxg:GridColumn FieldName="DepthTo" Header="До" />
            <dxg:GridColumn FieldName="ThNorm" Header="Мощность (норм)" />
            <dxg:GridColumn FieldName="CoreProc" Header="Керн, %" />
            <dxg:GridColumn FieldName="RockId" Header="Порода">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.RockLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Reserves" Header="В подсчёт" />
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding LithologyMenu}"
                DataNavigatorButtons="Navigation"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused"
                ShowingEditor="View_ShowingEditor" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
