<UserControl
    x:Class="Geonicle.Wpf.Views.Grids.LithologyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:helpers="clr-namespace:Geonicle.Wpf.Helpers"
    xmlns:menus="clr-namespace:Geonicle.Wpf.Menus"
    xmlns:behaviors="clr-namespace:Geonicle.Wpf.Behaviors">

    <UserControl.Resources>
        <!-- EditSettings колонок не видят DataContext, поэтому справочники берём через прокси. -->
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- DataContext наследуется от экрана (LithologyViewModel). Колонки и настройки грида «Литология» описаны только здесь.
         FilterCriteria задаёт модель экрана (слои выбранного пластопересечения, если стоит флажок);
         панель фильтра скрыта (ShowFilterPanelMode=Never), чтобы это условие не показывалось пользователю.
         Несколько строк выбираются мышью с Shift/Ctrl; выбранные строки используют пункты контекстного меню (пластопересечения). -->
    <dxg:GridControl
        ItemsSource="{Binding Lithology}"
        FilterCriteria="{Binding LithologyFilterCriteria, Mode=OneWay}"
        ShowLoadingPanel="{Binding InitializeCommand.IsExecuting}"
        AutoGenerateColumns="None"
        SelectionMode="Row"
        behaviors:GridRefresh.RefreshOnSave="True"
        behaviors:LithologyGridSelection.Enabled="True"
        RestoreStateKeyFieldName="LithologyId"
        RestoreStateOnSourceChange="True">

        <dxg:GridControl.Columns>
            <dxg:GridColumn FieldName="LithologyId" Header="ID" ReadOnly="True" />
            <dxg:GridColumn FieldName="DepthFrom" Header="От" />
            <dxg:GridColumn FieldName="DepthTo" Header="До" />
            <dxg:GridColumn FieldName="Angle" Header="Угол" />
            <dxg:GridColumn FieldName="Th" Header="Мощность" />
            <dxg:GridColumn FieldName="ThNorm" Header="Мощность (норм)" />
            <dxg:GridColumn FieldName="Core" Header="Керн" />
            <dxg:GridColumn FieldName="CoreNorm" Header="Керн (норм)" />
            <dxg:GridColumn FieldName="CoreProc" Header="Керн, %" />
            <dxg:GridColumn Name="colRockId" FieldName="RockId" Header="Код породы" />
            <dxg:GridColumn Name="colRock" FieldName="RockId" Header="Порода">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.RockLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="SeamName" Header="Пласт" ReadOnly="True" />
            <dxg:GridColumn FieldName="Formation" Header="Свита">
                <dxg:GridColumn.EditSettings>
                    <dxe:ComboBoxEditSettings
                        ItemsSource="{Binding Data.FormationLookup, Source={StaticResource ViewModelProxy}}"
                        ValueMember="Id"
                        DisplayMember="Name"
                        IsTextEditable="False" />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
        </dxg:GridControl.Columns>

        <dxg:GridControl.TotalSummary>
            <dxg:GridSummaryItem Alignment="Left" SummaryType="Count" />
        </dxg:GridControl.TotalSummary>

        <dxg:GridControl.View>
            <dxg:TableView
                menus:GridContextMenu.Menu="{Binding LithologyMenu}"
                DataNavigatorButtons="Navigation, AddNewRow, DeleteFocusedRow"
                ShowGroupPanel="False"
                ShowDataNavigator="True"
                AutoWidth="True"
                IncrementalSearchMode="Enabled"
                UseOnlyCurrentColumnInIncrementalSearch="True"
                IncrementalSearchClearDelay="1500"
                EditorShowMode="MouseDownFocused"
                ShowFilterPanelMode="Never" />
        </dxg:GridControl.View>
    </dxg:GridControl>
</UserControl>
